APP_NAME=Zoom Clone API
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Relative SQLite paths are resolved from the backend folder, regardless of cwd.
# On a host with persistent storage, point this at the mounted data directory.
DATABASE_URL=sqlite:///./data/zoom_clone.db
SEED_DATABASE=true
DEMO_USER_NAME=Demo User

# Leave blank to use the meeting APIs without a LiveKit account.
# Real call-token requests return 503 until all three values are configured.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=300
# Persistent random secret for account sessions and recovering account host access.
# Blank uses an ephemeral secret; restarting then invalidates account access tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
# Sole admin account: provision the account locally first, then set its ID/email.
# Never choose the demo user (ID 1). Signup cannot assign this role.
# ADMIN_USER_ID=2
ADMIN_EMAIL=
