APP_NAME=Zoom Clone API
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Relative SQLite paths are resolved from the backend folder, regardless of cwd.
# On a host with persistent storage, point this at the mounted data directory.
DATABASE_URL=sqlite:///./data/zoom_clone.db
SEED_DATABASE=true
DEMO_USER_NAME=Demo User

# Leave blank to use the meeting APIs without a LiveKit account.
# Real call-token requests return 503 until all three values are configured.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=300
